# Cloudinary — persistent CDN storage for avatars, banners, raw video
# uploads, artist tracks, and generated thumbnails. Create a free account
# at https://cloudinary.com, then copy these three values from your
# dashboard's "Product Environment Credentials" panel.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Comma-separated list of extra allowed CORS origins. The production Vercel
# frontend (https://reel-studio-wine.vercel.app) is always allowed by
# default in code, so it doesn't need to be listed here — add others (e.g.
# a staging URL) as needed:
# ALLOWED_ORIGINS=https://staging.example.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI (defaults to
# {BASE_URL}/api/v1/auth/google/callback if left unset).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Email — used to send the registration verification code.
# Leave unset in dev and verification codes will just print to the server console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="blessdhi.25@gmail.com"
SMTP_PASS="fntjicwxxvtpfqse"
SMTP_FROM="Reel Connect <no-reply@bledhi.app>"

# AI Co-Pilot (routes/ai.js) — real Claude caption/hashtag generation and
# draft refinement. Create a key at https://console.anthropic.com/settings/keys
# Leave unset and the AI Co-Pilot drawer still works — the frontend falls
# back to a local, non-AI template generator when these endpoints are
# unavailable or return an error.
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-haiku-4-5-20251001 (fast/cheap, appropriate
# for short captions). Set to e.g. claude-sonnet-5 for higher-quality output
# at a higher per-call cost.
ANTHROPIC_MODEL=""
