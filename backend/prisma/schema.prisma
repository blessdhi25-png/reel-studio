generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoType {
  short
  long
}

enum VideoStatus {
  processing
  published
  removed
}

enum TransactionType {
  tip
  ad_revenue_share
  subscription
  boost
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum UserRole {
  user
  moderator
  admin
}

enum AccountStatus {
  active
  suspended
  banned
}

enum ReportTargetType {
  video
  user
  comment
}

enum ReportReason {
  spam
  fraud_or_scam
  harassment_or_abuse
  impersonation
  intellectual_property
  child_safety
  sexual_content
  other
}

enum ReportStatus {
  pending
  reviewing
  resolved
  dismissed
}

enum AdminActionType {
  suspend_user
  ban_user
  reinstate_user
  remove_video
  delete_video
  resolve_report
  dismiss_report
  change_role
}

enum NotificationType {
  follow
  like
  comment
  tip
  message
  moderation
  live_started
  system
}

enum LiveStreamStatus {
  live
  ended
}

enum FeedEventType {
  impression
  watch_complete
  skip
  share
}

enum MessagePrivacy {
  everyone
  followers
  none
}

enum CommentPrivacy {
  everyone
  followers
  none
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  displayName   String?
  avatarUrl     String?
  bannerUrl     String?
  bio           String?
  creatorStatus Boolean  @default(false)
  stripeAccountId       String?  @unique
  stripeOnboarded       Boolean  @default(false)
  role          UserRole      @default(user)
  accountStatus AccountStatus @default(active)
  statusReason  String?
  emailVerified            Boolean   @default(false)
  emailVerificationCode    String?
  emailVerificationExpires DateTime?
  // Stores a SHA-256 hash of the reset token, never the raw token itself —
  // same reasoning as a password hash: if the DB ever leaked, a stored raw
  // token would let anyone reset any account's password directly, whereas
  // a hash is useless without the original value that only the email
  // recipient has.
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  isPrivate       Boolean        @default(false)
  messagePrivacy  MessagePrivacy @default(followers)
  commentPrivacy  CommentPrivacy @default(everyone)
  createdAt     DateTime @default(now())

  videos          Video[]
  artistProfile   ArtistProfile?
  comments        Comment[]
  likes           Like[]
  bookmarks       Bookmark[]
  followers       Follow[]      @relation("followee")
  following       Follow[]      @relation("follower")
  sentTx          Transaction[] @relation("sender")
  receivedTx      Transaction[] @relation("receiver")
  sentMessages     Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
  reportsFiled    Report[] @relation("reporter")
  adminActions    AdminAction[] @relation("actionAdmin")
  notifications          Notification[] @relation("notificationRecipient")
  triggeredNotifications Notification[] @relation("notificationActor")
  liveStreams      LiveStream[]
  liveChatMessages LiveChatMessage[]

  blocking  Block[] @relation("blocker")
  blockedBy Block[] @relation("blocked")

  stories          Story[]
  storyViews       StoryView[]
  storyLikes       StoryLike[]
  storyInteractions StoryInteraction[]
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Video {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  videoType       VideoType
  rawPath         String?
  videoUrl        String?
  thumbnailUrl    String?
  caption         String?
  circle          String?
  durationSeconds Int?
  viewCount       BigInt      @default(0)
  likeCount       BigInt      @default(0)
  commentCount    BigInt      @default(0)
  bookmarkCount   BigInt      @default(0)
  rankingScore    Float       @default(0)
  status          VideoStatus @default(processing)
  boostedUntil    DateTime?
  createdAt       DateTime    @default(now())

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id])

  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]
  transactions Transaction[]
  feedEvents   FeedEvent[]

  @@index([circle])
}

// Self-serve artist claim — mirrors how creatorStatus works elsewhere in this
// app (a simple flag, not a reviewed pipeline): there's no moderation queue
// for this yet, so registering immediately unlocks the Artist Hub rather
// than sitting in a fake "pending review" state nobody will ever act on.
model ArtistProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  stageName       String
  genre           String
  spotifyUrl      String?
  appleMusicUrl   String?
  youtubeUrl      String?
  managementEmail String?
  labelStatus     String   // 'independent' | 'signed'
  createdAt       DateTime @default(now())

  tracks Track[]
}

model Track {
  id              String        @id @default(uuid())
  artistId        String
  artist          ArtistProfile @relation(fields: [artistId], references: [id])
  title           String
  audioUrl        String
  durationSeconds Int?
  createdAt       DateTime      @default(now())

  videos Video[]
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("follower", fields: [followerId], references: [id])
  followee User @relation("followee", fields: [followeeId], references: [id])

  @@id([followerId, followeeId])
}

model Like {
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@id([userId, videoId])
}

model Bookmark {
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@id([userId, videoId])
}

model Comment {
  id               String    @id @default(uuid())
  videoId          String
  video            Video     @relation(fields: [videoId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  parentCommentId  String?
  content          String
  likeCount        Int       @default(0)
  createdAt        DateTime  @default(now())
}

model Transaction {
  id          String             @id @default(uuid())
  senderId    String
  sender      User               @relation("sender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User               @relation("receiver", fields: [receiverId], references: [id])
  videoId     String?
  video       Video?             @relation(fields: [videoId], references: [id])
  amountCents Int
  currency    String             @default("USD")
  type        TransactionType
  status      TransactionStatus  @default(pending)
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?
  createdAt   DateTime           @default(now())
}

model FeedEvent {
  id              String        @id @default(uuid())
  userId          String?
  videoId         String
  video           Video         @relation(fields: [videoId], references: [id])
  eventType       FeedEventType
  watchDurationMs Int?
  createdAt       DateTime      @default(now())

  @@index([videoId, createdAt])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("sentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("receivedMessages", fields: [receiverId], references: [id])
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  reporter     User             @relation("reporter", fields: [reporterId], references: [id])
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(pending)
  resolvedById String?
  resolution   String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model AdminAction {
  id         String          @id @default(uuid())
  adminId    String
  admin      User            @relation("actionAdmin", fields: [adminId], references: [id])
  actionType AdminActionType
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime        @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation("notificationRecipient", fields: [userId], references: [id])
  actorId    String?
  actor      User?            @relation("notificationActor", fields: [actorId], references: [id])
  type       NotificationType
  content    String
  targetType String?
  targetId   String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model LiveStream {
  id          String           @id @default(uuid())
  hostId      String
  host        User             @relation(fields: [hostId], references: [id])
  title       String
  category    String?
  tags        String?
  status      LiveStreamStatus @default(live)
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  peakViewers Int              @default(0)

  chatMessages LiveChatMessage[]

  @@index([status, startedAt])
}

model LiveChatMessage {
  id        String     @id @default(uuid())
  streamId  String
  stream    LiveStream @relation(fields: [streamId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime   @default(now())

  @@index([streamId, createdAt])
}

// Ephemeral posts — expire 24h after creation (see POST /stories). Text
// stories have no media; image/video stories carry a Cloudinary URL the
// same way Video/Track do. Poll and Q&A stickers are optional per-story,
// not separate objects: pollOptions is just [{id, label}] with vote
// tallies computed live from StoryInteraction rather than stored here,
// since a stored count can't be corrected if someone changes their vote.
model Story {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  mediaType       String   // 'image' | 'video' | 'text'
  mediaUrl        String?
  durationSeconds Float?   // video stories only — client reads real duration via HTMLVideoElement before upload; image/text use a fixed viewer-side duration instead
  textContent     String?
  backgroundColor String?
  linkUrl         String?
  linkLabel       String?
  pollQuestion    String?
  pollOptions     Json?    // [{ id, label }] — vote counts computed from StoryInteraction at read time
  qaQuestion      String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  views        StoryView[]
  likes        StoryLike[]
  interactions StoryInteraction[]

  @@index([userId, expiresAt])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation(fields: [viewerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
}

model StoryLike {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

// Covers both poll votes and Q&A answers rather than two near-identical
// tables — `type` distinguishes them, `value` holds the chosen option id
// (poll_vote) or the free-text answer (qa_response). One row per
// story+viewer+type: re-voting on a poll upserts this row rather than
// adding a second one.
model StoryInteraction {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // 'poll_vote' | 'qa_response'
  value     String
  createdAt DateTime @default(now())

  @@unique([storyId, userId, type])
}
