# Dependencies — always regenerated by npm install, never commit
node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# Environment files — contain secrets, never commit
.env
.env.local
.env.*.local

# Uploaded/generated media (local dev only)
backend/uploads/
backend/storage/

# Logs
npm-debug.log*
*.log

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/